#!/bin/sh
# Друга лінія захисту: відхиляє коміт із AI-атрибуцією, хоч би хто його робив.
# Увімкнути один раз:  git config core.hooksPath .githooks
if grep -Eiq 'co-authored-by:.*(claude|anthropic)|noreply@anthropic\.com|generated (with|by) \[?claude|claude\.(ai|com)/code|claude-session:' "$1"; then
  echo "commit-msg: у повідомленні є AI-атрибуція (Co-Authored-By Claude тощо). Прибери її." >&2
  exit 1
fi
exit 0
